{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git check-attr:*)",
      "Bash(godot --headless:*)",
      "Bash(gdlint:*)",
      "Bash(gdformat --diff:*)",
      "Bash(gdformat --check:*)",
      "Bash(uv run:*)",
      "Bash(uvx:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)"
    ]
  }
}
