root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Godot writes these itself; don't fight its formatting.
[*.{tscn,tres,godot}]
trim_trailing_whitespace = false

[*.gd]
indent_style = tab

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2
