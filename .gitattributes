# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot / project text formats — pin explicitly so Git never has to guess.
*.gd        text eol=lf
*.gdshader  text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.import    text eol=lf
*.uid       text eol=lf
*.cfg       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.svg       text eol=lf

# Binary assets — never apply EOL conversion, never try to diff as text.
# Without these, `text=auto` can corrupt a file it misdetects as text.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.gif       binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.ttf       binary
*.otf       binary
*.aseprite  binary
*.ase       binary
*.blend     binary
*.pck       binary
*.exe       binary
